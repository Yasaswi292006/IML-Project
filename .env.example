# =============================================================================
# ASTER — Adaptive Smart Traffic Event Response (Bengaluru Traffic Police)
# Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Duplicate this file and rename it to '.env':
#      cp .env.example .env
# 2. Replace the placeholder values with your actual configuration.
# 3. Never commit your production '.env' with sensitive keys to git repository.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Google Maps Platform API Key (Required for Maps, Places Search & Geocoding)
# ─────────────────────────────────────────────────────────────────────────────
# Enable the following APIs in your Google Cloud Console:
#   - Maps JavaScript API (Tactical Cordon, Heatmaps & Traffic Layer)
#   - Places API (New) / Places Autocomplete
#   - Geocoding API
GOOGLE_MAPS_API=AIzaSyYourGoogleMapsApiKeyHere
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# ─────────────────────────────────────────────────────────────────────────────
# Backend FastAPI Server Settings
# ─────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=False

# ─────────────────────────────────────────────────────────────────────────────
# Vite Frontend Client Settings (Optional override)
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_BASE=http://127.0.0.1:8000
